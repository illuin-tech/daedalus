---
/**
 * Table 2 as a matrix: rows are the memory (who generated it), columns the base agent that
 * uses it. Each cell is the MSR gain, shaded by its size; the diagonal is a model family using
 * its own memory. Cells fill in once the matrix is in view; hovering one names both scores.
 */
import { AGENTS, TRANSFER } from "../data/tables";

const max = Math.max(...TRANSFER.banks.flatMap((b) => b.gains.map((g) => g.v)));
---

<figure class="box tm" data-matrix>
  <span class="label"><b>table 2</b><span class="long"> heuristics transfer across model families</span></span>
  <div class="t-wrap">
    <table class="t tm-t">
      <thead>
        <tr><th class="tm-corner">memory generated by<br /><span class="muted">auxiliary / solver</span></th>
          {AGENTS.map((a, j) => <th data-col={j}>{a}</th>)}</tr>
      </thead>
      <tbody>
        <tr class="tm-base">
          <td>no memory <span class="muted">(MSR)</span></td>
          {TRANSFER.baseline.map((b, j) => <td data-col={j}><span class="val">{b.v.toFixed(1)}</span><span class="pm">±{b.se?.toFixed(1)}</span></td>)}
        </tr>
        {TRANSFER.banks.map((bank, i) => (
          <tr data-row-i={i}>
            <td class="tm-bank">{bank.aux}<br /><span class="muted">{bank.solver}</span></td>
            {bank.gains.map((g, j) => (
              <td data-col={j} class={["tm-cell", j === bank.family && "own"].filter(Boolean).join(" ")}
                style={`--a:${(8 + (g.v / max) * 34).toFixed(1)}%;--d:${(i * 3 + j) * 90}ms`}
                data-say={`${AGENTS[j]} with the ${bank.aux} / ${bank.solver} memory: ${TRANSFER.baseline[j].v.toFixed(1)} → ${(TRANSFER.baseline[j].v + g.v).toFixed(1)} MSR`}>
                <span class="val">+{g.v.toFixed(1)}</span><span class="pm">±{g.se?.toFixed(1)}</span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="tm-say" aria-live="polite">Hover a cell. <span class="own-key">◆</span> a family using its own memory.</p>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>("[data-matrix]")) {
    const say = fig.querySelector<HTMLElement>(".tm-say")!;
    const idle = say.innerHTML;
    const cells = [...fig.querySelectorAll<HTMLElement>(".tm-cell")];
    for (const c of cells) {
      c.addEventListener("mouseenter", () => {
        const col = c.dataset.col, row = c.parentElement!;
        fig.querySelectorAll("[data-col]").forEach((x) => x.classList.toggle("hl", (x as HTMLElement).dataset.col === col));
        fig.querySelectorAll("tbody tr").forEach((r) => r.classList.toggle("hl", r === row));
        say.textContent = c.dataset.say ?? "";
      });
    }
    fig.querySelector("table")!.addEventListener("mouseleave", () => {
      fig.querySelectorAll(".hl").forEach((x) => x.classList.remove("hl"));
      say.innerHTML = idle;
    });
    // Fill the cells, one after the other, once the matrix is in view.
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { fig.classList.add("in"); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(fig);
  }
</script>
